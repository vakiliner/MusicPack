root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
tab_width = 4
indent_style = tab
indent_size = 4

[*.yml]
indent_style = space
indent_size = 2
insert_final_newline = true

[**/src/*/resources/**.json]
insert_final_newline = unset

[**/src/*/resources/pack.mcmeta]
insert_final_newline = unset
